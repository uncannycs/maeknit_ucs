                <list string="Development Queue" decoration-primary="state=='mo_confirmed'" decoration-info="state=='produced'"  decoration-success="state=='done'" decoration-warning="state=='ready_to_spec'" decoration-muted="state=='cancelled'">
                    <field name="partner_id" optional="show"/>
