        <record id="view_bom_request_search" model="ir.ui.view">
            <field name="name">maeknit.bom.request.search</field>
            <field name="model">maeknit.bom.request</field>
            <field name="arch" type="xml">
                <search string="BOM Queue">
                    <!-- Main search fields that will be searched when typing in the search bar -->
                    <field name="name" string="Search" filter_domain="['|','|','|','|',
                            ('name', 'ilike', self),
                            ('product_id.name', 'ilike', self),
                            ('product_id.default_code', 'ilike', self),
                            ('partner_id.name', 'ilike', self),
                            ('sale_order_id.name', 'ilike', self)
                        ]"/>
                    <field name="product_id" string="Product" filter_domain="['|', ('product_id.name', 'ilike', self), ('product_id.default_code', 'ilike', self)]"/>
                    <field name="partner_id" string="Customer"/>
                    <!-- Additional searchable fields -->
                    <field name="sale_order_id"/>
                    <field name="partner_id"/>
                    <field name="product_id"/>
                    <field name="user_id"/>
                    <separator/>
                    <filter name="my_requests" string="My Requests" domain="[('user_id', '=', uid)]"/>
                    <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                    <filter name="ready_to_program" string="Ready to Program" domain="[('state', '=', 'ready_to_program')]"/>
                    <filter name="mo_confirmed" string="MO Confirmed" domain="[('state', '=', 'mo_confirmed')]"/>
                    <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                    <filter name="is_garment_bom" string="Development" domain="[('is_garment_bom', '=', True)]"/>
                    <filter name="is_grading_bom" string="Grading" domain="[('is_grading_bom', '=', True)]"/>
                    <filter name="is_production_bom" string="Production" domain="[('is_production_bom', '=', True)]"/>
                    <!-- <filter name="is_reverse_bom" string="Reverse Engineering" domain="[('is_reverse_bom', '=', True)]"/> -->
                     <filter name="is_swatch_bom" string="Swatching" domain="[('is_swatch_bom', '=', True)]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_by_user" string="Responsible" context="{'group_by': 'user_id'}"/>
                        <filter name="group_by_product" string="Product" context="{'group_by': 'product_id'}"/>
                        <filter name="group_by_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                        <filter name="group_by_stage" string="ECO Stage" context="{'group_by': 'stage_id'}"/>
                    </group>
                </search>
            </field>
        </record>

