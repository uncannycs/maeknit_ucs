<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Revision Request Wizard Form View -->
        <record id="view_revision_request_wizard_form" model="ir.ui.view">
            <field name="name">revision.request.wizard.form</field>
            <field name="model">revision.request.wizard</field>
            <field name="arch" type="xml">
                <form string="Request Revision">
                    <sheet>
                        <field name="show_sale_order_selection" invisible="1"/>
                        <field name="sale_order_line_id" invisible="1"/>
                        <field name="available_sale_orders" invisible="1"/>

                        <!-- Show connection info when no SO line is linked -->
                        <div class="alert alert-info" role="alert" invisible="not show_sale_order_selection">
                            <strong>Connect to Sale Order</strong>
                            <p>This revision needs to be connected to a Sale Order. Please select one below:</p>
                        </div>

                        <group invisible="not show_sale_order_selection">
                            <field name="product_id" readonly="1"/>
                            <field name="sale_order_id"
                                   domain="[('id', 'in', available_sale_orders)]"
                                   options="{'no_create': True}"
                                   required="show_sale_order_selection"/>
                        </group>

                        <group>
                            <field name="change_type"
                               options="{'no_create': True, 'no_create_edit': True, 'no_quick_create': True, 'no_open': True}"/>

                            <field name="responsible"/>
                        </group>
                        <group>
                            <field name="description" placeholder="Please describe the change needed..."/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_submit_request" string="Submit" type="object" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Revision Request Wizard Action -->
        <record id="action_revision_request_wizard" model="ir.actions.act_window">
            <field name="name">Request Revision</field>
            <field name="res_model">revision.request.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_sale_order_line_id': active_id}</field>
        </record>
    </data>
</odoo>
