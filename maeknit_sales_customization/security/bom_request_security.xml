<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company rule for BOM Request -->
        <record id="bom_request_company_rule" model="ir.rule">
            <field name="name">BOM Request: Multi-Company</field>
            <field name="model_id" ref="model_maeknit_bom_request"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
