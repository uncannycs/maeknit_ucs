<odoo>
    <data>
        <record id="view_order_form_inherit_replenishment" model="ir.ui.view">
            <field name="name">sale.order.form.replenishment</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <div name="button_box" position="inside">
                    <button name="action_view_replenishment_plan"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-bars"
                            string="Procurement"
                            >
                    </button>
                </div>
                <xpath expr="//header" position="inside">
                    <button name="action_generate_procurement" type="object" string="Generate Procurement" invisible="is_component_procurement_done and is_parent_procurement_done"/>
                </xpath>
                <xpath expr="//field[@name='payment_term_id']" position="after">
                    <field name="is_component_procurement_done" invisible="1"/>
                    <field name="is_parent_procurement_done" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='validity_date']" position="after">
                    <field name="factory_id"/>
                    <field name="shipping_destinations" invisible="1"/>
                    <field name="fg_shipping_destinations" invisible="1"/>
                    <field name="fg_shipping_destination_label" required="1"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
