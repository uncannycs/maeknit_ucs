<!--                                        <field name="product_id"/>-->
<!--                                        <field name="subcontractor_id" readonly="1"/>-->
<!--                                        <field name="vendor_id"/>-->
<!--                                        <field name="is_bom" column_invisible="1"/>-->
<!--                                        <field name="is_component" column_invisible="1"/>-->
<!--                                        <field name="qty"/>-->
<!--                                        <field name="onhand_qty" readonly="1" force_save="1"/>-->
<!--                                        <field name="add_qty"/>-->
<!--                                        <field name="final_qty" readonly="1" force_save="1"/>-->
<!--                                        <field name="sale_line_id" column_invisible="1"/>-->
<!--                                        <field name="route_id"/>-->
<!--                                        <field name="is_subcontracting"/>-->
<!--                                        <field name="is_create_procurement"/>-->
<!--                                    </list>-->
<!--                                </field>-->
<!--                            </group>-->
<!--                        </page>-->

                    </notebook>
                    <footer>
<!--                        <button name="generate_procurements" string="Create Procurements" type="object"-->
<!--                                class="btn btn-primary" data-hotkey="q"-->
<!--                                />-->
                        <button special="cancel" string="Discard" class="btn btn-secondary" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>