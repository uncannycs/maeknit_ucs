<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override the Contacts app menu to require the custom group -->
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="groups_id" eval="[Command.set([ref('maeknit_contact_customization.group_contacts_access')])]"/>
    </record>

    <!-- Override the Purchase app menu to require the custom group -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="groups_id" eval="[Command.set([ref('maeknit_contact_customization.group_purchase_access')])]"/>
    </record>
</odoo>
