<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view for product.color -->
    <record id="view_product_color_list" model="ir.ui.view">
        <field name="name">product.color.list</field>
        <field name="model">product.color</field>
        <field name="arch" type="xml">
            <list editable="bottom" class="o_list_view_ungrouped">
                <field name="technical" placeholder="Technical color code"/>
                <field name="generic" placeholder="Generic color name"/>
                <field name="cost" placeholder="Cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
            </list>
        </field>
    </record>

    <!-- Form view for product.color -->
    <record id="view_product_color_form" model="ir.ui.view">
        <field name="name">product.color.form</field>
        <field name="model">product.color</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="maeknit-form">
                        <div class="form-section">
                            <group>
                                <field name="product_tmpl_id" invisible="1"/>
                                <field name="technical" placeholder="Technical color code" class="form-control"/>
                                <field name="generic" placeholder="Generic color name" class="form-control"/>
                                <field name="cost" placeholder="Cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </div>
                    </div>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
