<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dry Library Form View -->
    <record id="view_dry_library_form" model="ir.ui.view">
        <field name="name">dry.library.form</field>
        <field name="model">dry.library</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Dry Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Dry Library List View -->
    <record id="view_dry_library_list" model="ir.ui.view">
        <field name="name">dry.library.list</field>
        <field name="model">dry.library</field>
        <field name="arch" type="xml">
            <list string="Dry Library" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Dry Library Search View -->
    <record id="view_dry_library_search" model="ir.ui.view">
        <field name="name">dry.library.search</field>
        <field name="model">dry.library</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Dry Library Action -->
    <record id="action_dry_library" model="ir.actions.act_window">
        <field name="name">Dry Library</field>
        <field name="res_model">dry.library</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new dry entry
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_dry_library"
              name="Dry Library"
              parent="mrp.menu_mrp_configuration"
              action="action_dry_library"
              sequence="33"/>
</odoo>
