<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fiber Type Form View -->
    <record id="view_fiber_type_form" model="ir.ui.view">
        <field name="name">fiber.type.form</field>
        <field name="model">fiber.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Fiber Type Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="value" placeholder="technical_value"/>
                        <field name="category_id" options="{'no_create_edit': False, 'no_quick_create': False}"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter fiber type description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fiber Type List View -->
    <record id="view_fiber_type_list" model="ir.ui.view">
        <field name="name">fiber.type.list</field>
        <field name="model">fiber.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="value"/>
                <field name="category_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Fiber Type Search View -->
    <record id="view_fiber_type_search" model="ir.ui.view">
        <field name="name">fiber.type.search</field>
        <field name="model">fiber.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="value"/>
                <field name="category_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Category" name="groupby_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Fiber Type Action -->
    <record id="action_fiber_type" model="ir.actions.act_window">
        <field name="name">Fiber Types</field>
        <field name="res_model">fiber.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new fiber type
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_fiber_type"
              name="Fiber Types"
              parent="stock.menu_product_in_config_stock"
              action="action_fiber_type"
              sequence="20"/>
</odoo>
