<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Create a custom action for BOMs -->
    <record id="action_view_boms_from_product" model="ir.actions.server">
        <field name="name">View BOMs</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="state">code</field>
        <field name="code">
            action = model.browse(env.context.get('active_id')).action_view_boms_custom()
        </field>
    </record>
</odoo>