<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Gauge Library Form View -->
    <record id="view_gauge_library_form" model="ir.ui.view">
        <field name="name">gauge.library.form</field>
        <field name="model">gauge.library</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Gauge Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="sequence" readonly="1"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter gauge description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Gauge Library List View -->
    <record id="view_gauge_library_list" model="ir.ui.view">
        <field name="name">gauge.library.list</field>
        <field name="model">gauge.library</field>
        <field name="arch" type="xml">
            <list string="Gauges" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
        
    </record>
    

    <!-- Gauge Library Search View -->
    <record id="view_gauge_library_search" model="ir.ui.view">
        <field name="name">gauge.library.search</field>
        <field name="model">gauge.library</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Gauge Library Action -->
    <record id="action_gauge_library" model="ir.actions.act_window">
        <field name="name">Gauges</field>
        <field name="res_model">gauge.library</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new gauge
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_gauge_library"
              name="Gauges"
              parent="mrp.menu_mrp_configuration"
              action="action_gauge_library"
              sequence="31"/>
</odoo>
