<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fiber Category Form View -->
    <record id="view_fiber_category_form" model="ir.ui.view">
        <field name="name">fiber.category.form</field>
        <field name="model">fiber.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_fiber_types" type="object" class="oe_stat_button" icon="fa-list">
                            <field name="fiber_type_count" string="Fiber Types" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Category Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Enter category description..."/>
                        </page>
                        <page string="Fiber Types">
                            <field name="fiber_type_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fiber Category List View -->
    <record id="view_fiber_category_list" model="ir.ui.view">
        <field name="name">fiber.category.list</field>
        <field name="model">fiber.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="fiber_type_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Fiber Category Search View -->
    <record id="view_fiber_category_search" model="ir.ui.view">
        <field name="name">fiber.category.search</field>
        <field name="model">fiber.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Fiber Category Action -->
    <record id="action_fiber_category" model="ir.actions.act_window">
        <field name="name">Fiber Categories</field>
        <field name="res_model">fiber.category</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new fiber category
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_fiber_category"
              name="Fiber Categories"
              parent="stock.menu_product_in_config_stock"
              action="action_fiber_category"
              sequence="19"/>
</odoo>
