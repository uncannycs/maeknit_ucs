<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Filter product_id on Purchase Order (RFQ) lines -->
    <record id="purchase_order_form_yarn_filter" model="ir.ui.view">
        <field name="name">purchase.order.form.yarn.filter</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <!-- List view product_id (hidden by purchase_product_matrix, but still used internally) -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', 'parent_of', parent.company_id)]</attribute>
                <attribute name="context">{
                    'partner_id': parent.partner_id,
                    'quantity': product_qty,
                    'company_id': parent.company_id,
                    'default_detailed_type': 'product'
                }</attribute>
            </xpath>

            <!-- List view product_template_id (the actual visible field from purchase_product_matrix) -->
            <xpath expr="//field[@name='order_line']//list//field[@name='product_template_id']" position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', 'parent_of', parent.company_id)]</attribute>
                <attribute name="context">{
                    'partner_id': parent.partner_id,
                    'default_detailed_type': 'product'
                }</attribute>
            </xpath>

            <!-- Form view product_id -->
            <xpath expr="//field[@name='order_line']//form//field[@name='product_id']" position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]</attribute>
                <attribute name="context">{
                    'partner_id': parent.partner_id,
                    'default_detailed_type': 'product'
                }</attribute>
            </xpath>

        </field>
    </record>

</odoo>
