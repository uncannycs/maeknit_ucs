<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchase_quotation_document_maeknit"
              inherit_id="purchase.report_purchase_quotation_document">

        <!-- Add Unit Price and Subtotal column headers -->
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_unit_price" class="text-end"><strong>Unit Price</strong></th>
            <th name="th_subtotal" class="text-end"><strong>Subtotal</strong></th>
        </xpath>

        <!-- Add Unit Price and Subtotal data cells for each product line -->
        <xpath expr="//td[@class='text-end']" position="after">
            <td class="text-end">
                <span t-field="order_line.price_unit"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
            <td class="text-end">
                <span t-field="order_line.price_subtotal"
                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
            </td>
        </xpath>

    </template>
</odoo>
