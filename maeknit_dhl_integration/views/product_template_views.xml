<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_landed_cost" model="ir.ui.view">
        <field name="name">product.template.form.inherit.landed.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="lookup_id" readonly="1"/>
                <field name="hs_code"/>
                <field name="country_of_origin"/>
                <field name="is_generated" invisible="1"/>
                <field name="product_classification_name"/>
                <field name="yarn_product_name" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_view_inherit_landed_cost" model="ir.ui.view">
        <field name="name">product.template.form.inherit.landed.cost</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <div name="options" position="inside">
                <field name="is_dhl"/>
                <label for="is_dhl"/>
            </div>
        </field>
    </record>
</odoo>
