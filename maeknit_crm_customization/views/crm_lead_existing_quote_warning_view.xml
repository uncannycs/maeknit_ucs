<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_existing_quote_warning_form" model="ir.ui.view">
        <field name="name">crm.lead.existing.quote.warning.form</field>
        <field name="model">crm.lead.existing.quote.warning</field>
        <field name="arch" type="xml">
            <form string="Existing Quotation Warning">
                <field name="warning_message" readonly="1" widget="html"/>
                <field name="lead_id" invisible="1"/>
                <field name="existing_order_id" invisible="1"/>
                <footer>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
