<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View with Buttons -->
    <record id="view_shipping_mail_tree" model="ir.ui.view">
        <field name="name">maeknit.shipping.mail.tree</field>
        <field name="model">maeknit.shipping.mail</field>
        <field name="arch" type="xml">
            <!-- Added button in list view header for fetch emails -->
            <list string="Shipping Emails" create="false">
                <header>
                    <button name="action_fetch_emails" string="Fetch Emails" type="object" class="btn-primary"/>
                    <button name="action_extract_tracking" string="Extract Tracking Numbers" type="object" class="btn-secondary"/>
                </header>
                <field name="subject"/>
                <field name="email_from"/>
                <field name="tracking_count" string="Tracking #"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_shipping_mail_form" model="ir.ui.view">
        <field name="name">maeknit.shipping.mail.form</field>
        <field name="model">maeknit.shipping.mail</field>
        <field name="arch" type="xml">
            <form string="Shipping Email">
                <header>
                    <button name="action_extract_tracking" 
                            string="Extract Tracking Numbers" 
                            type="object" 
                            class="oe_highlight"
                            icon="fa-search"/>
                    <button name="action_view_tracking" 
                            string="View Tracking" 
                            type="object" 
                            class="oe_stat_button"
                            icon="fa-truck"
                            invisible="tracking_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tracking" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-list">
                            <field name="tracking_count" widget="statinfo" string="Tracking"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="email_from"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Email Body">
                            <field name="body" widget="html"/>
                        </page>
                        <page string="Tracking Numbers">
                            <field name="tracking_ids" readonly="1">
                                <list>
                                    <field name="tracking_number"/>
                                    <field name="carrier_code"/>
                                    <field name="status"/>
                                    <field name="last_event"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_shipping_mail" model="ir.actions.act_window">
        <field name="name">Shipping Emails</field>
        <field name="res_model">maeknit.shipping.mail</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No shipping emails found
            </p>
            <p>
                Emails will appear here automatically when received at the configured email alias.
            </p>
        </field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
