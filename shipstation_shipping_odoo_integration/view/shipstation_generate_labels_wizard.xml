<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_shipstation_generate_all_labels_wizard_form" model="ir.ui.view">
            <field name="name">shipstation.generate.all.labels.wizard.form</field>
            <field name="model">shipstation.generate.all.labels.wizard</field>
            <field name="arch" type="xml">
                <form string="Generate All Labels">
                    <sheet>
                        <div class="oe_title">
                            <h1>Generate Shipping Labels</h1>
                        </div>

                        <group>
                            <group string="Shipping Address">
                                <field name="partner_id"/>
                                <field name="partner_street"/>
                                <field name="partner_street2"
                                       invisible="not partner_street2"/>
                                <div class="d-flex gap-2">
                                    <field name="partner_city" nolabel="1"
                                           placeholder="City"/>
                                    <field name="partner_state" nolabel="1"
                                           placeholder="State"/>
                                    <field name="partner_zip" nolabel="1"
                                           placeholder="ZIP"/>
                                </div>
                                <field name="partner_country"/>
                            </group>
                            <group string="Shipping Info">
                                <field name="picking_id" readonly="1"/>
                                <field name="carrier_id"/>
                                <field name="shipping_charge_id"/>
                                <field name="package_count"/>
                            </group>
                        </group>

                        <separator string="Packages"/>
                        <field name="package_ids" readonly="0">
                            <list editable="bottom">
                                <field name="name" string="Package" readonly="1"/>
                                <field name="length" string="L (in)"/>
                                <field name="width" string="W (in)"/>
                                <field name="height" string="H (in)"/>
                                <field name="shipping_weight" string="Weight (lbs)"/>
                                <field name="minimum_weight" string="Min Wt (lbs)"
                                       readonly="1"/>
                                <field name="custom_tracking_number"
                                       string="Tracking #" readonly="1"/>
                            </list>
                        </field>
                    </sheet>

                    <footer>
                        <button name="action_check_rates"
                                string="Check Rates"
                                type="object"
                                class="btn-secondary"/>
                        <button name="action_generate_all_labels"
                                string="Generate All Labels"
                                type="object"
                                class="btn-primary"/>
                        <button string="Close"
                                class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
