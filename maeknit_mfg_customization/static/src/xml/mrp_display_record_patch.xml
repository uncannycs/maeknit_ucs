<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="mrp_workorder.MrpDisplayRecord" t-inherit="mrp_workorder.MrpDisplayRecord" t-inherit-mode="extension">
    
    <xpath expr="//div[contains(@class, 'card-title')]" position="after">
        <t t-if="props.record.resModel === 'mrp.workorder'">
          <div class="">
            <div class="small text-muted fw-normal">
              <t>
                <span>Attempt <t t-esc="props.record.data.knit_attempt || props.record.data.x_knit_attempt || 1"/></span>
              </t>
              <t>
                <span class="ms-2">| Program v<t t-esc="props.record.data.program_version || props.record.data.x_program_version || 1"/></span>
              </t>
            </div>
          </div>
        </t>
      </xpath>
      

    <xpath expr="//MrpWorksheet" position="after">
      <li t-if="props.record.resModel == 'mrp.workorder' and filesState and !filesState.isLoading and filesState.instructionFiles.length > 0"
          class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center cursor-pointer"
          t-on-click="(ev) => this.openInstructionFiles(ev)">
        <span class="btn-link d-flex align-items-center">
          <i class="fa fa-file-text-o me-2" title="Instruction Files"/>
          Instruction Files
        </span>
        <button class="btn btn-sm btn-secondary"
                t-on-click.stop="(ev) => this.downloadAllInstructions(ev)"
                title="Download All Instructions">
          <i class="fa fa-download"/>
        </button>
      </li>

      <li t-if="props.record.resModel == 'mrp.workorder' and filesState and !filesState.isLoading and filesState.programFiles.length > 0"
          class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center cursor-pointer"
          t-on-click="(ev) => this.openProgramFiles(ev)">
        <span class="btn-link d-flex align-items-center">
          <i class="fa fa-lightbulb-o me-2" title="Program Files"/>
          Program Files
        </span>
        <button class="btn btn-sm btn-secondary"
                t-on-click.stop="(ev) => this.downloadAllPrograms(ev)"
                title="Download All Programs">
          <i class="fa fa-download"/>
        </button>
      </li>

      <!-- Re-program button for Knit workorders -->
      <li t-if="props.record.resModel == 'mrp.workorder' and this.isKnitWorkorder()"
          class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center cursor-pointer"
          t-on-click="(ev) => this.openRequestNewProgram(ev)"
          style="background-color: #fff3cd;">
        <span class="btn-link d-flex align-items-center text-warning fw-bold">
          <i class="fa fa-refresh me-2" title="Re-program"/>
          Re-program
        </span>
        <i class="fa fa-exclamation-triangle text-warning"/>
      </li>
    </xpath>
  </t>
</templates>
