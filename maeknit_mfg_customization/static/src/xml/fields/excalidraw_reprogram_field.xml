<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="maeknit_mfg_customization.ExcalidrawReprogramField">
        <div class="o_field_excalidraw_reprogram" style="border:1px solid #dee2e6;border-radius:6px;overflow:hidden;background:#fff;">

            <!-- Toolbar -->
            <div class="d-flex align-items-center px-2 py-1 bg-light border-bottom" style="gap:6px;min-height:32px;">
                <i class="fa fa-pencil text-muted"/>
                <span class="text-muted" style="font-size:12px;flex:1;">
                    Sketch (optional) — draw to illustrate the issue
                </span>
                <span t-if="state.isExporting" class="badge bg-info text-white" style="font-size:10px;">
                    <i class="fa fa-spinner fa-spin me-1"/> Saving sketch…
                </span>
            </div>

            <!-- Loading overlay -->
            <div t-if="state.isLoading"
                 class="d-flex align-items-center justify-content-center text-muted"
                 style="height:360px;font-size:13px;">
                <i class="fa fa-spinner fa-spin me-2"/> Loading sketch tool…
            </div>

            <!-- Excalidraw canvas (React renders here) -->
            <div t-ref="canvasRef"
                 t-att-style="state.isLoading ? 'display:none' : 'width:100%;height:360px;'"/>
        </div>
    </t>
</templates>
