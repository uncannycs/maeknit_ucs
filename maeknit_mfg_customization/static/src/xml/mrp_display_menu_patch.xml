<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="mrp_workorder.MrpDisplayMenuDialog" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('button_list')]" position="inside">
            <button class="btn btn-outline-secondary d-flex justify-content-between align-items-center p-3 fs-3"
                    t-on-click="callReknitAction"
                    name="callReknitAction">
                Re-knit<i class="oi oi-chevron-right"/>
            </button>
        </xpath>
    </t>
</templates>
