<?xml version="1.0" encoding="UTF-8"?>
<templates id="maeknit_mfg_customization_templates" xml:space="preserve">
  <t t-name="maeknit_mfg_customization.MrpWorksheetPatch"
     t-inherit="mrp_workorder.MrpWorksheet" t-inherit-mode="extension">

    <!-- Existing addition -->
    <xpath expr="//li[contains(@class,'o_mrp_record_line')][1]" position="after">
      <li class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center">
        <span t-on-click="onProgramClick">Program Files</span>
        <div class="btn" t-on-click="onDownloadAllClick">
          <i class="fa fa-lg fa-download"/>
        </div>
      </li>

      <!-- Added more robust fallback for field access -->
      <li class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center">
        <span>Knit Attempt</span>
        <span t-esc="props.record.data.knit_attempt || props.record.data.x_knit_attempt || '-'"/>
      </li>
      <li class="o_mrp_record_line list-group-item d-flex justify-content-between align-items-center">
        <span>Program Count</span>
        <span t-esc="props.record.data.program_version || props.record.data.x_program_version || '-'"/>
      </li>
    </xpath>
  </t>
</templates>
