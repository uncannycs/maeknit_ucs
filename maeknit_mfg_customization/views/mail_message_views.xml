<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_reprogram_note_body_form" model="ir.ui.view">
            <field name="name">mail.message.reprogram.note.body</field>
            <field name="model">mail.message</field>
            <field name="arch" type="xml">
                <form string="Program note">
                    <sheet>
                        <div class="o_reprogram_note_viewer">
                            <field name="body" nolabel="1" widget="html" readonly="1" options="{'toolbar': False}"/>
                        </div>
                    </sheet>
                    <footer>
                        <button string="Close" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
