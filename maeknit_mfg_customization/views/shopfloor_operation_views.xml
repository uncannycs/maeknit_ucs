<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopfloor_operation_list" model="ir.ui.view">
        <field name="name">shopfloor.operation.list</field>
        <field name="model">maeknit.shopfloor.operation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="workcenter_tag_ids"
                widget="many2many_tags"
                string="Workcenter Tags"
                options="{'no_create_edit': True, 'no_quick_create': True}"/>
               </list>
        </field>
    </record>

    <record id="view_shopfloor_operation_form" model="ir.ui.view">
        <field name="name">shopfloor.operation.form</field>
        <field name="model">maeknit.shopfloor.operation</field>
        <field name="arch" type="xml">
            <form string="Shopfloor Operation">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="workcenter_tag_ids" widget="many2many_tags"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Shopfloor Operation Action -->
    <record id="action_shopfloor_operation" model="ir.actions.act_window">
        <field name="name">Shopfloor Operations</field>
        <field name="res_model">maeknit.shopfloor.operation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id','in', allowed_company_ids)]</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                    Create a new shopfloor operations 
            </p>
        </field>
    </record>

    <record id="menu_shopfloor_operation_config" model="ir.ui.menu">
        <field name="name">Shopfloor Operations</field>
        <field name="parent_id" ref="mrp.menu_mrp_configuration"/>
        <field name="action" ref="action_shopfloor_operation"/>
        <field name="sequence" eval="95"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_shopfloor_operation_config" name="Shopfloor Operations" parent="mrp.menu_mrp_configuration" action="action_shopfloor_operation" sequence="20"/>

</odoo>
