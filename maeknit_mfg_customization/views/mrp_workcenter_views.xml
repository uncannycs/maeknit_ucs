<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit mrp.workcenter form view to add gauge_id field -->
    <record id="mrp_workcenter_view_form_inherit" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.inherit.gauge</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <!-- Add gauge_id field after the Tag field -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="gauge_ids" widget="many2many_tags"
                options="{'no_create': True, 'no_open': True}"/>
                 </xpath>
        </field>
    </record>
</odoo>
