<odoo>
    <!-- Action to open the list -->
    <record id="action_bom_operation_template" model="ir.actions.act_window">
        <field name="name">BOM Operation Templates</field>
        <field name="res_model">maeknit.bom.operation.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'default_company_id': allowed_company_ids[0]}</field>

        <field name="help" type="html">
            <p>
                Create reusable templates of operations to quickly populate BOM Requests.
            </p>
        </field>
    </record>

    <!-- Menu under Manufacturing Configuration -->
    <menuitem id="menu_bom_operation_template_root"
              name="BOM Operation Templates"
              parent="mrp.menu_mrp_configuration"
              sequence="50"
              action="action_bom_operation_template"/>
    <!-- List View -->
    <record id="view_bom_operation_template_list" model="ir.ui.view">
        <field name="name">maeknit.bom.operation.template.list</field>
        <field name="model">maeknit.bom.operation.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="line_ids" widget="one2many_list"/>
                <field name="related_service"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bom_operation_template_form" model="ir.ui.view">
        <field name="name">maeknit.bom.operation.template.form</field>
        <field name="model">maeknit.bom.operation.template</field>
        <field name="arch" type="xml">
            <form string="BOM Operation Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="related_service" widget="radio" options="{'horizontal': true}"/>
                        <field name="company_id" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <notebook>
                        <page string="Operation Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="operation_id" domain="[('company_id', '=', parent.company_id)]"/>
                                    <field name="user_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                                </list>
                                <form>
                                    <group>
                                        <field name="sequence"/>
                                        <field name="operation_id" domain="[('company_id', '=', parent.company_id)]"/>
                                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
