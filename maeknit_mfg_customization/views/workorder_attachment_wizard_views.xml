<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Added tree view for displaying attachments with timestamps -->
        <record id="view_attachment_display_tree" model="ir.ui.view">
            <field name="name">ir.attachment.display.tree</field>
            <field name="model">ir.attachment</field>
            <field name="arch" type="xml">
                <list string="Files" create="false" edit="false" delete="true">
                    <field name="name" string="Filename"/>
                    <field name="write_date" string="Last Updated"/>
                </list>
            </field>
        </record>

        <!-- Rename File Form View -->
        <record id="view_attachment_rename_form" model="ir.ui.view">
            <field name="name">ir.attachment.rename.form</field>
            <field name="model">ir.attachment</field>
            <field name="arch" type="xml">
                <form string="Rename File">
                    <sheet>
                        <group>
                            <field name="name" string="File Name" placeholder="Enter new file name..." required="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_close_rename" string="Save" type="object" class="btn-primary" special="save"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
        
        <!-- Workorder Attachment Wizard Form View -->
        <record id="view_workorder_attachment_wizard_form" model="ir.ui.view">
            <field name="name">workorder.attachment.wizard.form</field>
            <field name="model">workorder.attachment.wizard</field>
            <field name="arch" type="xml">
                <form string="Upload Files">
                    <sheet>
                        <!-- Hidden fields -->
                        <field name="attachment_type" invisible="1"/>
                        <field name="has_notes" invisible="1"/>
                        <field name="is_wash_workorder" invisible="1"/>
                        <field name="is_dry_workorder" invisible="1"/>

                        <!-- Title -->
                        <div class="oe_title">
                            <h1>
                                <field name="workorder_id" readonly="1" nolabel="1" class="oe_inline"/>
                            </h1>
                        </div>

                        <!-- Wash Library dropdown (only for Wash workorders) -->
                        <group invisible="not is_wash_workorder">
                            <field name="wash_library_id" options="{'no_create': true}"/>
                        </group>

                        <!-- Dry Library dropdown (only for Dry workorders) -->
                        <group invisible="not is_dry_workorder">
                            <field name="dry_library_id" options="{'no_create': true}"/>
                        </group>

                        <!-- Tabs -->
                        <notebook>
                            <!-- Tab 1: Files -->
                            <page string="Files" name="files_tab">
                                <group string="Current Files" invisible="not existing_attachment_display_ids">
                                    <field name="existing_attachment_display_ids"
                                           nolabel="1"
                                           context="{'tree_view_ref': 'maeknit_mfg_customization.view_attachment_display_tree'}">
                                        <list string="Files" create="false" edit="false" delete="false" open="0">
                                            <field name="name" string="Filename" readonly="1"/>
                                            <field name="write_date" string="Last Updated" readonly="1"/>
                                            <button name="action_download_file"
                                                    type="object"
                                                    icon="fa-download"
                                                    class="btn-link text-primary"
                                                    title="Download this file"/>
                                            <button name="action_rename_file"
                                                    type="object"
                                                    icon="fa-edit"
                                                    class="btn-link text-info"
                                                    title="Rename this file"/>
                                            <button name="action_delete_file"
                                                    type="object"
                                                    icon="fa-trash"
                                                    class="btn-link text-danger"
                                                    title="Delete this file"
                                                    confirm="Are you sure you want to delete this file?"/>
                                        </list>
                                    </field>
                                </group>

                                <!-- Show message if no files -->
                                <div class="alert alert-info" role="alert" invisible="existing_attachment_display_ids">
                                    <strong>No files uploaded yet</strong>
                                    <p>Upload your first file using the section below.</p>
                                </div>

                                <!-- Download All Buttons -->
                                <group string="Download All Files" invisible="not existing_attachment_display_ids">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <button name="action_download_all_separate"
                                                    string="Download All (Separate)"
                                                    type="object"
                                                    class="btn-secondary"
                                                    icon="fa-download"
                                                    help="Download all files separately, one by one"/>
                                        </div>
                                        <div class="col-md-6">
                                            <button name="action_download_all_zip"
                                                    string="Download All as ZIP"
                                                    type="object"
                                                    class="btn-secondary"
                                                    icon="fa-file-archive-o"
                                                    help="Download all files in a single ZIP archive"/>
                                        </div>
                                    </div>
                                </group>

                                <!-- Upload New Files section -->
                                <group string="Upload New Files">
                                    <field name="attachment_ids"
                                           widget="many2many_binary"
                                           nolabel="1"
                                           options="{'accepted_file_extensions': '.pdf,.doc,.docx,.txt,.jpg,.png,.zip'}"/>
                                </group>
                            </page>
                            <!-- Tab 2: Notes (WITH content) - Shows when has_notes = True -->
                            <page string="Notes" name="notes_tab_with_content" class="bg-secondary" invisible="not text_content">
                                <!-- Quick Add Note Section -->
                                <group string="Add New Note">
                                    <field name="quick_note_text"
                                           placeholder="Enter note here. Click 'Add Note' to append it with timestamp..."
                                           nolabel="1"
                                           class="note-text-field"
                                           colspan="2"/>
                                    <button name="action_add_quick_note"
                                            string="Add Note"
                                            type="object"
                                            class="btn-primary"
                                            icon="fa-plus"/>
                                </group>

                                <!-- Reprogram Notes (from mail messages, with images) -->
                                <group string="Reprogram Notes" invisible="not reprogram_notes_html">
                                    <field name="reprogram_notes_html" widget="html" nolabel="1" colspan="2" readonly="1" options="{'toolbar': False}"/>
                                </group>

                                <!-- Full Notes History -->
                                <group string="Notes History" invisible="not text_content">
                                    <field name="text_content"
                                           widget="text"
                                           placeholder="No notes yet. Add your first note above..."
                                           nolabel="1"
                                           colspan="2"
                                           options="{'style': 'font-family: monospace; background-color: #f8f9fa; padding: 10px; border-radius: 4px;'}"/>
                                </group>

                                <!-- Show message if no notes -->
                                <div class="alert alert-info" role="alert" invisible="text_content">
                                    <strong>No notes yet</strong>
                                    <p>Add your first note using the form above.</p>
                                </div>
                            </page>

                            <!-- Tab 1: Notes (NO content) - Shows when has_notes = False -->
                            <page string="Notes" name="notes_tab_no_content" invisible="text_content">
                                <!-- Quick Add Note Section -->
                                <group string="Add New Note">
                                    <field name="quick_note_text"
                                           placeholder="Enter note here. Click 'Add Note' to append it with timestamp..."
                                           nolabel="1"
                                           class="note-text-field"
                                           colspan="2"/>
                                    <button name="action_add_quick_note"
                                            string="Add Note"
                                            type="object"
                                            class="btn-primary"
                                            icon="fa-plus"/>
                                </group>

                                <!-- Reprogram Notes (from mail messages, with images) -->
                                <group string="Reprogram Notes" invisible="not reprogram_notes_html">
                                    <field name="reprogram_notes_html" widget="html" nolabel="1" colspan="2" readonly="1" options="{'toolbar': False}"/>
                                </group>

                                <!-- Full Notes History -->
                                <group string="Notes History" invisible="not text_content">
                                    <field name="text_content"
                                           widget="text"
                                           placeholder="No notes yet. Add your first note above..."
                                           nolabel="1"
                                           colspan="2"
                                           options="{'style': 'font-family: monospace; background-color: #f8f9fa; padding: 10px; border-radius: 4px;'}"/>
                                </group>

                                <!-- Show message if no notes -->
                                <div class="alert alert-info" role="alert" invisible="text_content">
                                    <strong>No notes yet</strong>
                                    <p>Add your first note using the form above.</p>
                                </div>
                            </page>

                            

                            <!-- Tab 3: Chatter -->
                            <page string="Chatter" name="chatter_tab">
                                <field name="workorder_id" widget="workorder_chatter" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_add_attachments" string="Save" type="object" class="btn-primary" icon="fa-save"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
