<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mrp_program_files_wizard_form" model="ir.ui.view">
        <field name="name">mrp.program.files.wizard.form</field>
        <field name="model">mrp.program.files.wizard</field>
        <field name="arch" type="xml">
            <form string="Files Viewer">
                <sheet>
                    <!-- Made title and description dynamic based on file_type -->
                    <div class="oe_title">
                        <h1><field name="wizard_title" readonly="1" nolabel="1"/></h1>
                        <p><field name="wizard_description" readonly="1" nolabel="1"/></p>
                    </div>
                    
                    <group>
                        <field name="workorder_id" invisible="1"/>
                        <!-- Added file_type field as invisible to track the type -->
                        <field name="file_type" invisible="1"/>
                        <field name="selected_attachment_id" widget="selection" 
                               options="{'no_create': True, 'no_open': True}" class="mb-3"/>
                    </group>
                    
                    <!-- Preview section -->
                    <div class="mb-3">
                        <field name="attachment_preview" readonly="1" nolabel="1" widget="html"/>
                    </div>
                </sheet>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
