<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_form_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.form.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']/.." position="inside">
                <field name="invoices_paid" widget="boolean_toggle"></field>
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_tree_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.tree.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="invoices_paid" optional="show" widget="boolean_toggle" />
            </xpath>
        </field>
    </record>

    <record id="sale_order_view_search_inherit" model="ir.ui.view">
        <field name="name">sale.order.view.search.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_create_date']" position="after">
                <filter name="filter_paid" string="Invoice Paid"
                    domain="[('invoices_paid', '=', True)]" />
                <filter name="filter_not_paid" string="Invoice Not Paid"
                    domain="[('invoices_paid', '=', False)]" />
            </xpath>
        </field>
    </record>

</odoo>